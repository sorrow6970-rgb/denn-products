rules_version = '2';

// DENN Products — Firestore 보안 규칙
// spaces/{token}: 암호화된 고객 시안 '스페이스'(dennSpace). 토큰을 아는 사람만 접근(URL ?space=<token>).
//   내용은 클라이언트에서 AES-GCM 암호화되어 저장되므로, read 공개여도 비번 없이는 복호화 불가.
// ⚠️ Auth 미도입 상태 → create 익명 허용. 도입 시 non-anonymous로 좁힐 수 있음.
//
// rebuildAdminState/head: 리빌드 운영자 상태의 ★유일한 가변 정본(스펙 037 §4.3~4.4).
//   revision을 정확히 1씩 올리는 compare-and-set으로만 움직이며, Storage 객체는 불변이다.
// rebuildAdminStateObjects/{recId}: G-4 구조 A의 write-once 소비 기록(REC).
//   REC은 upload 전에 별도 create되고, head는 REC의 claimedBase가 현재 revision과 맞을 때만 이동한다.
//
// ★★ 배포 금지 (스펙 037 §9 / Founder G-1)
//   APPROVED_OPERATOR_UID가 UNCONFIRMED placeholder다. 실제 운영자 UID 정본 제공 전 배포하지 않는다.

service cloud.firestore {
  match /databases/{database}/documents {

    match /spaces/{token} {
      function approvedSpaceOperator() {
        return request.auth != null
          && request.auth.token.firebase.sign_in_provider != 'anonymous'
          && request.auth.uid == 'UNCONFIRMED_OPERATOR_UID_REPLACE_BEFORE_DEPLOY';
      }
      function validV2Document() {
        return request.resource.data.keys().hasOnly(['schema', 'enc'])
          && request.resource.data.keys().hasAll(['schema', 'enc'])
          && request.resource.data.schema == 'space-v2'
          && request.resource.data.enc is map
          && request.resource.data.enc.keys().hasOnly(['salt', 'iv', 'ct'])
          && request.resource.data.enc.keys().hasAll(['salt', 'iv', 'ct'])
          && request.resource.data.enc.salt is string
          && request.resource.data.enc.iv is string
          && request.resource.data.enc.ct is string;
      }
      allow get: if true;                  // 토큰(문서ID)을 알아야 접근 가능 + 내용은 암호화됨
      allow list: if false;                // JJ-3=A: 컬렉션 열거 금지
      // 기존 non-V2/schema-less create는 현행 호환을 유지하고 space-v2만 새 권한·shape로 좁힌다.
      allow create: if !('schema' in request.resource.data)
                      || request.resource.data.schema != 'space-v2'
                      || (approvedSpaceOperator() && validV2Document());
      allow update, delete: if false;      // 생성 후 변경/삭제 금지(무결성)
    }

    // 리빌드 운영자 상태 head — 승인된 운영자 UID만, 정확히 head 문서 하나만.
    match /rebuildAdminState/{docId} {
      function approvedOperator() {
        return request.auth != null
          && request.auth.token.firebase.sign_in_provider != 'anonymous'
          && request.auth.uid == 'UNCONFIRMED_OPERATOR_UID_REPLACE_BEFORE_DEPLOY';
      }
      function validHeadKeys() {
        return request.resource.data.keys().hasOnly(['schemaVersion', 'revision', 'recId'])
          && request.resource.data.keys().hasAll(['schemaVersion', 'revision', 'recId']);
      }
      function validRecId() {
        return request.resource.data.recId is string
          && request.resource.data.recId.matches(
               '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}[.]json$');
      }
      function validRevision() {
        return request.resource.data.revision is int
          && request.resource.data.schemaVersion == 1;
      }
      function claim() {
        return get(/databases/$(database)/documents/rebuildAdminStateObjects/$(request.resource.data.recId));
      }

      // baseline load가 성립하려면 head를 읽을 수 있어야 한다.
      allow get:    if approvedOperator() && docId == 'head';
      allow list:   if false;              // 컬렉션 열거 금지

      // 최초 생성은 revision 1만.
      allow create: if approvedOperator() && docId == 'head'
                       && validHeadKeys() && validRecId() && validRevision()
                       && request.resource.data.revision == 1
                       && claim().data.claimedBase == 0;

      // 이후에는 정확히 +1이고 recId가 이전 값과 달라야 한다.
      // REC의 claimedBase 일치가 과거 recId 재사용을 막고 결과 불명 판정을 가능하게 한다.
      allow update: if approvedOperator() && docId == 'head'
                       && validHeadKeys() && validRecId() && validRevision()
                       && request.resource.data.revision == resource.data.revision + 1
                       && request.resource.data.recId != resource.data.recId
                       && claim().data.claimedBase == resource.data.revision;

      allow delete: if false;
    }

    // G-4 구조 A의 영구 소비 기록. 문서 ID는 Storage objectId와 동일한 UUID.json이다.
    match /rebuildAdminStateObjects/{recId} {
      function approvedOperator() {
        return request.auth != null
          && request.auth.token.firebase.sign_in_provider != 'anonymous'
          && request.auth.uid == 'UNCONFIRMED_OPERATOR_UID_REPLACE_BEFORE_DEPLOY';
      }
      function validRecId() {
        return recId.matches(
          '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}[.]json$');
      }
      allow create: if approvedOperator() && validRecId()
                      && request.resource.data.keys().hasOnly(['claimedBase'])
                      && request.resource.data.keys().hasAll(['claimedBase'])
                      && request.resource.data.claimedBase is int
                      && request.resource.data.claimedBase >= 0;
      allow read, update, delete: if false;
    }

    // 그 외 컬렉션 기본 거부.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
