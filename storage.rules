rules_version = '2';

// DENN Products — Firebase Storage 보안 규칙 (보안 B: 운영자 Auth)
//
// ★단일 match + 경로별 조건: Firebase 규칙은 겹치는 match를 OR(하나라도 허용하면 통과)하므로,
//   catch-all(read:if true)과 admin/ 매치를 따로 두면 catch-all이 admin/까지 열어버림(겹침 버그).
//   → 하나의 재귀 match 안에서 경로(allPaths)로 분기해 겹침을 원천 제거.
//
// 정책:
//   - read : admin/* 는 로그인 운영자(non-anon)만 / 그 외는 공개(소비자 발행본·이미지 읽기).
//   - write: temp-share/*·proofs/* 는 익명 허용(소비자 공유/시안) / 그 외(admin·published·에셋)는 운영자만.
//     둘 다 20MB 상한.
// ⚠️ read 조건에 request.resource.size 금지(read시 resource=null → 항상 거부).

service firebase.storage {
  match /b/{bucket}/o/{allPaths=**} {
    function op() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function consumerWrite() {
      return allPaths.matches('temp-share/.*') || allPaths.matches('proofs/.*');
    }

    allow read: if allPaths.matches('admin/.*') ? op() : true;
    allow write: if request.resource.size < 20 * 1024 * 1024
                 && ( consumerWrite() ? true : op() );
  }
}
