rules_version = '2';

// DENN Products — Firebase Storage 보안 규칙
//
// 앱이 쓰는 경로: published/(발행본 JSON) · temp-share/(공유 스냅샷 JSON) · templates/ ·
//   placeholders/ · guides/ · mockups/ · editor-overlays/ · proofs/ (이미지).
// 경로가 많고 앞으로 늘 수 있어 '경로 화이트리스트'로 조이면 누락 시 이미지 오프로드가 깨짐 →
//   대신 '읽기 공개 + 쓰기 용량 제한'으로 모든 경로를 안전하게 커버(악의적 대용량/무단 업로드 범위 축소).
//
// ⚠️ 현재 Firebase Auth(운영자 로그인)가 없어 모두 익명 상태 → published/ 등 운영자 전용 쓰기도
//    익명에 열려 있음(공개 소스라 경로 노출 → 악의적 덮어쓰기 잔여 위험). 근본 차단은 운영자 Auth 도입 후
//    write 규칙을 non-anonymous로 좁히는 것(예: allow write: if request.auth != null &&
//    request.auth.token.firebase.sign_in_provider != 'anonymous'). 소비자 write(temp-share/proofs)는 익명 유지 필요.

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read: if true;                              // 소비자가 발행본/이미지 읽어야 함
      allow write: if request.resource.size < 20 * 1024 * 1024;  // 20MB 상한(대용량 악용 차단)
    }
  }
}
