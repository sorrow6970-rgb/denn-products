# 데이터 백업 파일 (Git 관리 안 함)
*.json
DENN-current-data-*.json
DENN-data-*.json
backup.json

# 리빌드 설정 JSON은 정상 추적 (데이터 백업 *.json 무시와 양립; git add -f 불필요)
!package.json
!**/package.json
!tsconfig*.json
!**/tsconfig*.json
!biome.json
!**/biome.json
# firebase.json / .firebaserc 는 기존 추적 유지(운영 설정, 무변경). *.json 무시는 신규 데이터 JSON에만 적용.

# 리빌드 빌드 산출물 / 도구 출력
node_modules/
**/node_modules/
dist/
**/dist/
coverage/
**/coverage/
playwright-report/
**/playwright-report/
test-results/
**/test-results/
*.tsbuildinfo

# 임시 파일
*.tmp
*.bak
*.old
*~

# OS 자동 생성 파일
Thumbs.db
.DS_Store
desktop.ini

# 작업 참고용 스크린샷 (로컬 전용, Git 관리 안 함)
SCREEN SHOT/
스크린샷/

# 백업 폴더
backups/
backup/
old/

# 작업 중인 임시 파일
*-WIP.html
*-temp.html
*-test.html

# 에디터 설정
.vscode/
.idea/
*.swp

# 런처 3종 (DENN어드민/풀세트/작업시작) 모두 추적. 머신별 차이는 작업시작.bat 내부에서 PATH 검색 + 표준 위치 폴백으로 흡수.

