# Windows shell scripts must be CRLF for cmd.exe multi-line parsing.
# LF-only .bat files break multi-line for/if/( ... ) blocks even on Win11.
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Biome formats with LF, so a CRLF working copy fails `node scripts/check.mjs` at the format step
# even though the committed blob is already LF. `core.autocrlf=true` is what produces that CRLF copy
# on a Windows checkout. These three exact paths are pinned to LF so the gate reproduces on a clean
# Windows checkout. Deliberately NOT a global *.ts/*.tsx rule: repo-wide line-ending policy is its
# own decision, not something a spec 080 correction should make.
apps/mockup/src/space/SpacePasswordGate.tsx       text eol=lf
apps/mockup/src/space/SpacePasswordGate.test.tsx  text eol=lf
tests/e2e/space-production-route.spec.ts          text eol=lf

# Same reason, spec 081. Still per-path, still not a global *.ts/*.tsx rule.
apps/admin/src/space-v2/issue-session.ts          text eol=lf
apps/admin/src/space-v2/issue-session.test.ts     text eol=lf
