rules_version = '2';

// DENN Products — Firestore 보안 규칙
// spaces/{token}: 암호화된 고객 시안 '스페이스'(dennSpace). 토큰을 아는 사람만 접근(URL ?space=<token>).
//   내용은 클라이언트에서 AES-GCM 암호화되어 저장되므로, read 공개여도 비번 없이는 복호화 불가.
// ⚠️ Auth 미도입 상태 → create 익명 허용. 도입 시 non-anonymous로 좁힐 수 있음.
//
// rebuildAdminState/head: 리빌드 운영자 상태의 ★유일한 가변 정본(스펙 037 §4.3~4.4).
//   revision을 정확히 1씩 올리는 compare-and-set으로만 움직이며, Storage 객체는 불변이다.
//   ⚠️ Rules는 objectPath 문자열의 형태만 검사한다. 그 경로에 객체가 실제로 있는지는
//      cross-service 질문이라 Rules로 증명할 수 없고, 읽기 fail-closed가 그 간극을 흡수한다.
//
// ★★ 배포 금지 (스펙 037 §9 / Founder G-1)
//   APPROVED_OPERATOR_UID가 UNCONFIRMED placeholder다. 실제 운영자 UID 정본 제공 전 배포하지 않는다.

service cloud.firestore {
  match /databases/{database}/documents {

    match /spaces/{token} {
      allow read: if true;                 // 토큰(문서ID)을 알아야 접근 가능 + 내용은 암호화됨
      allow create: if true;               // 시안 스페이스 생성(운영자/고객)
      allow update, delete: if false;      // 생성 후 변경/삭제 금지(무결성)
    }

    // 리빌드 운영자 상태 head — 승인된 운영자 UID만, 정확히 head 문서 하나만.
    match /rebuildAdminState/{docId} {
      function approvedOperator() {
        return request.auth != null
          && request.auth.token.firebase.sign_in_provider != 'anonymous'
          && request.auth.uid == 'emulator-operator-DO-NOT-DEPLOY';
      }
      function validHeadKeys() {
        return request.resource.data.keys().hasOnly(['schemaVersion', 'revision', 'objectPath'])
          && request.resource.data.keys().hasAll(['schemaVersion', 'revision', 'objectPath']);
      }
      function validObjectPath() {
        return request.resource.data.objectPath is string
          && request.resource.data.objectPath.matches(
               '^rebuild-admin-state/objects/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}[.]json$');
      }
      function validRevision() {
        return request.resource.data.revision is int
          && request.resource.data.schemaVersion == 1;
      }

      // baseline load가 성립하려면 head를 읽을 수 있어야 한다.
      allow get:    if approvedOperator() && docId == 'head';
      allow list:   if false;              // 컬렉션 열거 금지

      // 최초 생성은 revision 1만.
      allow create: if approvedOperator() && docId == 'head'
                       && validHeadKeys() && validObjectPath() && validRevision()
                       && request.resource.data.revision == 1;

      // 이후에는 정확히 +1이고 objectPath가 이전 값과 달라야 한다.
      // (objectPath 교체 강제가 결과 불명 시 "내 commit이 반영됐는가" 판정을 가능하게 한다.)
      allow update: if approvedOperator() && docId == 'head'
                       && validHeadKeys() && validObjectPath() && validRevision()
                       && request.resource.data.revision == resource.data.revision + 1
                       && request.resource.data.objectPath != resource.data.objectPath;

      allow delete: if false;
    }

    // 그 외 컬렉션 기본 거부.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
