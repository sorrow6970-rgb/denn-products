rules_version = '2';

// DENN Products — Firebase Storage 보안 규칙 (보안 B: 운영자 Auth)
//
// ★경로별 명시 match: Firebase는 겹치는 match를 OR(하나라도 허용하면 통과)하므로 catch-all read:if true를
//   쓰면 admin/까지 노출됨. 그래서 catch-all read 없이 공개 경로를 명시하고, admin/은 자기 match만 둠.
//   미지정 경로는 매치 없음 → 기본 거부(자동).
//
// 정책:
//   - admin/            : 로그인 운영자(non-anon)만 read. ★write는 거부(스펙 037 G-1: 읽기 전용 고정).
//   - rebuild-admin-state/: 승인된 운영자 UID만. ★create만 허용하고 update/delete 거부(불변 객체).
//   - temp-share/·proofs/: 공개 read + 익명 write(소비자 공유/시안).
//   - published/·templates/·placeholders/·guides/·mockups/·editor-overlays/: 공개 read + 운영자만 write.
//   - 그 외             : 거부.
// ⚠️ read 조건에 request.resource.size 금지(read시 resource=null → 항상 거부).
//
// ★★ 배포 금지 (스펙 037 §9 / Founder G-1)
//   APPROVED_OPERATOR_UID가 UNCONFIRMED placeholder다. 실제 운영자 UID 정본이 제공되기 전에는
//   이 파일을 배포하지 않는다. 또한 admin/ write를 닫으면 denn-admin.html:740의 저장이 서버에서
//   거부되므로, 리빌드 쓰기 경로가 준비되기 전에 배포하면 운영자가 아무 데도 저장할 수 없는 구간이 생긴다.
//   배포 순서는 별도 cutover 스펙과 별도 Founder 승인 대상이다.

service firebase.storage {
  match /b/{bucket}/o {
    function op() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function okSize() { return request.resource.size < 20 * 1024 * 1024; }

    // ★ 승인된 운영자 UID 한정. op()를 바꾸지 않고 새 함수로 새 경로에만 건다 —
    //   op()를 UID 제한으로 바꾸면 published/·templates/·guides/ 등 레거시 write까지 함께 잠긴다.
    function approvedOperator() {
      return op()
        && request.auth.uid == 'emulator-operator-DO-NOT-DEPLOY';
    }

    // 리빌드 전용 불변 상태 객체 — 별도 최상위 경로라 겹치는 상위 match가 없다.
    // resource == null 이 "이미 존재하면 거부"를 서버에서 강제한다(create-only).
    match /rebuild-admin-state/objects/{objectId} {
      allow read:   if approvedOperator();
      allow create: if approvedOperator()
                       && resource == null
                       && okSize()
                       && request.resource.contentType == 'application/json';
      allow update: if false;
      allow delete: if false;
    }

    // 관리자 상태 — 비공개. ★읽기 전용(스펙 037 G-1).
    match /admin/{p=**} {
      allow read: if op();
      allow write: if false;
    }

    // 소비자 익명 write — 공유 스냅샷 / 시안 이미지
    match /temp-share/{p=**} { allow read: if true; allow write: if okSize(); }
    match /proofs/{p=**}     { allow read: if true; allow write: if okSize(); }

    // 발행본 · 운영자 에셋 — 공개 read + 운영자만 write
    match /published/{p=**}       { allow read: if true; allow write: if op() && okSize(); }
    match /templates/{p=**}       { allow read: if true; allow write: if op() && okSize(); }
    match /placeholders/{p=**}    { allow read: if true; allow write: if op() && okSize(); }
    match /guides/{p=**}          { allow read: if true; allow write: if op() && okSize(); }
    match /mockups/{p=**}         { allow read: if true; allow write: if op() && okSize(); }
    match /editor-overlays/{p=**} { allow read: if true; allow write: if op() && okSize(); }
  }
}
